cat > .env.example << 'EOF'
# ===========================================
# ECD Final ML - Environment Configuration
# ===========================================

# 📋 Project Settings
PROJECT_NAME=ecd_final_ml
ENVIRONMENT=development
DEBUG=True

# 📁 Data Paths
KDHS_KR_FILE=data/raw/KEKR8CFL.SAV
KENYA_GEOJSON=geo/kenya_counties.geojson

# 🔗 API Configuration
API_URL=http://127.0.0.1:5000
API_HOST=0.0.0.0
API_PORT=5000

# 🎨 Streamlit Dashboard
STREAMLIT_PORT=8501
STREAMLIT_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=false

# 🤗 Hugging Face (for models & large data)
# Get token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL_REPO=collinsbiwott36/ecd-delay-prediction-model
HF_DATA_REPO=collinsbiwott36/ecd-child-development-data

# 🔐 Security (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# 📊 Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 🗄️ Database (if needed later)
# DATABASE_URL=postgresql://user:password@localhost:5432/ecd_db
EOF